# ==============================================================================
# WhatsApp Food Ordering Bot - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in the values for your deployment.
# NEVER commit the actual '.env' file or real credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Flask Environment
# ------------------------------------------------------------------------------
# Options: development | production | testing
FLASK_ENV=development
APP_ENV=development

# Secret key used for signing session cookies and internal security tokens.
# IN PRODUCTION: Generate a secure 32+ character random hex string:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-secret-key-change-in-prod

# Comma-separated list of allowed HTTP Host headers / domain names.
# In production set to your custom domain: e.g. "api.yourrestaurant.com,your-app.fly.dev"
ALLOWED_HOSTS=*

# Port for the web server (defaults to 5000)
PORT=5000

# Webhook request timeout in seconds
REQUEST_TIMEOUT_SECONDS=10


# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL connection string for production:
#   postgresql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>
# For local development:
#   sqlite:///dev.db
DATABASE_URL=sqlite:///dev.db


# ------------------------------------------------------------------------------
# 3. Session Store & Distributed State
# ------------------------------------------------------------------------------
# Session store type: 'memory' for single-instance dev, 'redis' for multi-worker production
SESSION_STORE_TYPE=memory

# Redis instance/cluster URL (required when SESSION_STORE_TYPE=redis)
# Example: redis://default:your-redis-password@redis-host:6379/0
REDIS_URL=redis://localhost:6379/0

# Session time-to-live in seconds (default: 86400 = 24 hours)
SESSION_TTL_SECONDS=86400


# ------------------------------------------------------------------------------
# 4. Twilio WhatsApp API Credentials
# ------------------------------------------------------------------------------
# Your Twilio Account SID (starts with 'AC')
# Found in Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio Auth Token (Keep this SECRET)
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Your Twilio WhatsApp sender number with 'whatsapp:' prefix
# Sandbox example: whatsapp:+14155238886
# Production example: whatsapp:+919876543210
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Enforce Twilio HMAC-SHA1 Webhook Signature Validation
# In production, this MUST be 'true'. Set to 'false' only for manual offline Postman testing.
TWILIO_VALIDATE_SIGNATURE=true


# ------------------------------------------------------------------------------
# 5. Payment Gateway Webhook Configuration
# ------------------------------------------------------------------------------
# Shared secret for verifying payment gateway HMAC-SHA256 callback signatures
# Generate a strong 32+ character secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_here

# Payment callback replay attack tolerance window (in seconds)
PAYMENT_REPLAY_WINDOW_SECONDS=300


# ------------------------------------------------------------------------------
# 6. Rate Limiting & Abuse Protection Policy
# ------------------------------------------------------------------------------
# Max requests per minute per IP on public WhatsApp webhook (POST /whatsapp)
WEBHOOK_RATE_LIMIT=60

# Max messages per minute per WhatsApp phone number
USER_MESSAGE_RATE_LIMIT=20

# Max callback requests per minute per IP on payment callback (POST /payment/webhook)
PAYMENT_WEBHOOK_RATE_LIMIT=30

# Max payment initiation / retry attempts per order within 5 minutes
PAYMENT_INITIATION_LIMIT=3

# Max invalid promo code guesses before user is locked out and required to 'skip'
PROMO_ATTEMPT_LIMIT=5


# ------------------------------------------------------------------------------
# 7. Logging & Monitoring
# ------------------------------------------------------------------------------
# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
